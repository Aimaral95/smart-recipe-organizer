# Copy this file to `.env.local` and fill in your real keys.
# .env.local is git-ignored — your keys stay on your machine.
#
# Two API key variables, used by different code paths:
#
# 1. VITE_ANTHROPIC_API_KEY (browser)
#    Used by `npm run dev` so you don't have to run a serverless function
#    runner locally. Vite only exposes env vars with the VITE_ prefix to
#    the browser bundle.
#
# 2. ANTHROPIC_API_KEY (server-only)
#    Used by api/generate-recipe.js (the Vercel serverless function).
#    No VITE_ prefix means it stays on the server. This is what you
#    configure in Vercel's project settings for production.
#
# In production, only ANTHROPIC_API_KEY is needed. In dev, only
# VITE_ANTHROPIC_API_KEY is needed (unless you use `vercel dev`, in which
# case set both — same value is fine).

VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — only if you want to use the Mistral fallback path.
VITE_HF_ACCESS_TOKEN=hf_your-token-here

# Optional — auto-photo for saved recipes via the Unsplash Search API.
# Register a free app at https://unsplash.com/developers, then paste the
# "Access Key" (NOT the secret key) below. Leave unset to skip the feature
# entirely — recipes will save imageless and the user can upload manually.
VITE_UNSPLASH_ACCESS_KEY=your-unsplash-access-key
